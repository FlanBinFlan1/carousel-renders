{var it=[],all=root.querySelectorAll(\"*\");for(var i=0;i<all.length;i++){var e=all[i];if(skip(e,root))continue;var cs=getComputedStyle(e);var o={e:e,fs:parseFloat(cs.fontSize)};if(e.tagName===\"IMG\"&&cs.maxHeight!==\"none\")o.mh=parseFloat(cs.maxHeight);it.push(o);}return it;}function apply(it,s){for(var i=0;i<it.length;i++){var o=it[i];o.e.style.fontSize=(o.fs*s)+\"px\";if(o.mh)o.e.style.maxHeight=(o.mh*s)+\"px\";}}function over(r){return r.scrollHeight>r.clientHeight+2||r.scrollWidth>r.clientWidth+2;}function fitAll(){var roots=document.querySelectorAll(SEL);for(var r=0;r<roots.length;r++){var root=roots[r];if(!root.__it)root.__it=prep(root);var s=BASE;apply(root.__it,s);var n=0;while(over(root)&&s>0.55&&n<30){s-=0.03;apply(root.__it,s);n++;}root.setAttribute(\"data-fit\",s.toFixed(2));}}fitAll();if(document.fonts&&document.fonts.ready)document.fonts.ready.then(fitAll);window.addEventListener(\"load\",fitAll);setTimeout(fitAll,600);})();</script></body></html>"}]}